# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=WEBTE2
APP_ENV=production
APP_DEBUG=false
# Run this once after cloning to generate a key:
# docker compose run --rm backend php artisan key:generate --show
APP_KEY=

# ── API Auth ────────────────────────────────────────────────────────────────────
# All /api/* routes require: Authorization: Bearer <this value>
API_TOKEN=change-me-to-a-long-random-secret

# ── Database ────────────────────────────────────────────────────────────────────
DB_DATABASE=webte2
DB_USERNAME=webte2
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# ── Octave Bridge ───────────────────────────────────────────────────────────────
OCTAVE_BRIDGE_URL=http://bridge:3001
BRIDGE_SECRET=change-me-to-a-long-random-secret
SESSION_TTL_MINUTES=30

# ── Simulation ──────────────────────────────────────────────────────────────────
# Extra milliseconds added server-side before returning results (0 = off)
SIMULATION_SLOWDOWN_MS=0

# ── Statistics ──────────────────────────────────────────────────────────────────
STATS_COOLDOWN_MINUTES=10

# ── PDF Generation ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://frontend:80
CHROMIUM_PATH=/usr/bin/chromium
